generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  phone        String           @default("")
  organization String           @default("")
  roleTitle    String           @default("")
  city         String           @default("")
  role         String           @default("CUSTOMER")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orders       Order[]
  quotes       QuoteRequest[]
  services     ServiceRequest[]
  audits       AuditLog[]
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  note     String    @default("")
  isDemo   Boolean   @default(false)
  products Product[]
}

model Product {
  id                String            @id @default(cuid())
  slug              String            @unique
  sku               String            @unique
  name              String
  summary           String            @default("")
  description       String            @default("")
  searchText        String            @default("")
  brandId           String
  brand             Brand             @relation(fields: [brandId], references: [id])
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  priceGnf          BigInt?
  availability      String            @default("ON_ORDER")
  stockQty          Int?
  leadTimeNote      String            @default("")
  usageNotes        String            @default("")
  installationNotes String            @default("")
  accessoriesNote   String            @default("")
  warrantyNote      String            @default("")
  audience          String            @default("")
  usage             String            @default("")
  featured          Boolean           @default(false)
  active            Boolean           @default(true)
  isDemo            Boolean           @default(false)
  allowCart         Boolean           @default(true)
  allowQuote        Boolean           @default(true)
  allowQuestion     Boolean           @default(true)
  specs             String            @default("[]")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  images            ProductImage[]
  documents         ProductDocument[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([active, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model ProductDocument {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title      String
  storedName String
  mime       String
  authorized Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model DeliveryOption {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  fulfillment String
  feeGnf      BigInt?
  feePending  Boolean @default(false)
  delayNote   String  @default("")
  active      Boolean @default(true)
  isDemo      Boolean @default(false)
  sortOrder   Int     @default(0)
}

model Order {
  id               String      @id @default(cuid())
  reference        String      @unique
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  idempotencyKey   String      @unique
  status           String      @default("PENDING_PAYMENT")
  customerName     String
  organization     String      @default("")
  email            String
  phone            String
  city             String
  addressLine      String      @default("")
  area             String      @default("")
  notes            String      @default("")
  fulfillment      String
  deliveryOptionId String      @default("")
  deliveryName     String      @default("")
  shippingPending  Boolean     @default(false)
  subtotalGnf      BigInt
  shippingGnf      BigInt      @default(0)
  totalGnf         BigInt
  intendedMethod   String      @default("")
  createAccount    Boolean     @default(false)
  stockApplied     Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
  payments         Payment[]
  proforma         Proforma?

  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  name         String
  sku          String
  quantity     Int
  unitPriceGnf BigInt
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String         @default("PENDING")
  method         String
  provider       String
  amountGnf      BigInt
  currency       String         @default("GNF")
  idempotencyKey String         @unique
  providerRef    String         @default("")
  checkoutUrl    String         @default("")
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         PaymentEvent[]

  @@index([status, createdAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerEventId String   @unique
  type            String
  status          String
  payload         String   @default("{}")
  createdAt       DateTime @default(now())
}

model QuoteRequest {
  id           String       @id @default(cuid())
  reference    String       @unique
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  name         String
  organization String       @default("")
  roleTitle    String       @default("")
  phone        String
  email        String
  city         String
  need         String
  status       String       @default("NEW")
  internalNote String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        QuoteItem[]
  attachments  Attachment[]
  proforma     Proforma?

  @@index([status, createdAt])
}

model QuoteItem {
  id        String       @id @default(cuid())
  quoteId   String
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  sku       String       @default("")
  quantity  Int          @default(1)
}

model Attachment {
  id           String        @id @default(cuid())
  quoteId      String?
  quote        QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  storedName   String
  originalName String
  mime         String
  size         Int
  createdAt    DateTime      @default(now())
}

model ServiceRequest {
  id           String   @id @default(cuid())
  reference    String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  serviceType  String
  equipment    String   @default("")
  location     String
  urgency      String   @default("NORMAL")
  description  String
  name         String
  organization String   @default("")
  phone        String
  email        String
  status       String   @default("NEW")
  internalNote String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  reference String   @unique
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model PrivacyRequest {
  id        String   @id @default(cuid())
  reference String   @unique
  name      String
  email     String
  phone     String   @default("")
  type      String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model PageContent {
  id          String   @id @default(cuid())
  slug        String
  locale      String   @default("fr")
  title       String
  description String   @default("")
  body        String   @default("")
  needsReview Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([slug, locale])
}

model SiteSetting {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String   @default("")
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Proforma {
  id              String        @id @default(cuid())
  number          String        @unique
  kind            String
  orderId         String?       @unique
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId         String?       @unique
  quote           QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerName    String
  organization    String        @default("")
  email           String
  phone           String        @default("")
  city            String        @default("")
  addressLine     String        @default("")
  lines           String        @default("[]")
  subtotalGnf     BigInt?
  shippingGnf     BigInt?
  shippingPending Boolean       @default(false)
  totalGnf        BigInt?
  pricePending    Boolean       @default(false)
  includesDemo    Boolean       @default(false)
  deliveryName    String        @default("")
  sourceReference String
  sentStatus      String        @default("QUEUED")
  sentError       String        @default("")
  createdAt       DateTime      @default(now())

  @@index([email])
}

model Notification {
  id          String   @id @default(cuid())
  channel     String
  recipient   String
  subject     String
  body        String
  status      String
  error       String   @default("")
  relatedType String   @default("")
  relatedId   String   @default("")
  createdAt   DateTime @default(now())
}

model Counter {
  key   String @id
  value Int
}

model RateBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}
