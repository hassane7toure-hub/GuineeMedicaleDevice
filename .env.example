# Copier ce fichier vers .env puis remplacer chaque valeur.
# Ne jamais y placer un secret déjà utilisé en production, et ne jamais le committer.

# SQLite local. En production, PostgreSQL est préférable :
# postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/gmd
DATABASE_URL="file:./dev.db"

# Au moins 32 caractères aléatoires.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# test = sandbox interne, aucun débit. live = prestataire réel, uniquement après contrat.
PAYMENT_MODE="test"
PAYMENT_WEBHOOK_SECRET="replace-with-another-long-random-string"

# URL publique, sans slash final. Sert aux redirections de paiement et au référencement.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Compte équipe créé au premier seed uniquement. À changer avant toute mise en ligne.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme-demo-only"

# Destinataire des notifications commerciales. Vide = pas d'e-mail, suivi dans l'administration.
SALES_EMAIL=""

# SMTP facultatif. Tant que SMTP_HOST est vide, les messages restent dans l'administration.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE="false"

# CinetPay — laisser vide tant que le contrat marchand, l'éligibilité Guinée
# et le règlement en francs guinéens ne sont pas confirmés par le prestataire.
# Le site refuse d'activer ce prestataire si la devise n'est pas GNF.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_CURRENCY=""

# true uniquement derrière un reverse proxy HTTPS.
ENFORCE_HTTPS="false"
